# SQLite locale. Su Vercel lascia vuoto: il build crea un db demo.
# Per dati persistenti usa Postgres (Neon) e metti postgresql://...
DATABASE_URL="file:./dev.db"

# Auth.js — in produzione genera un segreto vero (npm run check:live lo stampa)
AUTH_SECRET="zecca-demo-secret-cambia-in-produzione-32ch"

# URL pubblico HTTPS del sito (obbligatorio in live, es. https://zecca.example)
# AUTH_URL="https://tuo-dominio"

# Pagamenti veri (Stripe). Senza queste chiavi resta solo la demo.
# Non incollare le chiavi in chat: mettile solo qui, in locale o sull’hosting.
# Un payout Stripe versa SOLO sul conto bancario collegato all’account Stripe
# di Massimo: non invia euro all’IBAN del cliente.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# USDC su Base mainnet — Circle developer-controlled wallets (invio automatico).
# Obbligatorie tutte e tre, solo in env (mai nel client):
# CIRCLE_API_KEY="TEST_API_KEY:..."          # o chiave live PREFIX:ID:SECRET
# CIRCLE_WALLET_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# CIRCLE_ENTITY_SECRET="64 caratteri hex (32 byte)"
# Facoltative:
# CIRCLE_API_HOST="https://api.circle.com"   # sandbox: https://api-sandbox.circle.com
# CIRCLE_USDC_TOKEN_ID=""                    # UUID token Circle, se lo preferisci all’address
# CIRCLE_USDC_TOKEN_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
# Senza le tre obbligatorie: «Wallet negozio non configurato», fusione aperta.
# Wallet SCA su BASE (Gas Station). Finanzia solo USDC nativo Base.
# CIRCLE_WALLET_ADDRESS="0xaa7b4d75b80b145163d1f1caacd8b1b468fcca08"
# In Console: Gas Station → policy default su Base (mainnet), attiva.
# Spread Forgia (conversione tesoreria). 100 bps = 1%.
# Se manca la riga in Forgia, si usa env poi il default codice (100).
# FORGIA_SPREAD_BPS="100"
# FORGIA_SPREAD_BPS_EUR="100"
# FORGIA_SPREAD_BPS_USD="100"
# FORGIA_SPREAD_BPS_CHF="100"
# FORGIA_SPREAD_BPS_USDC="100"
# Commissione prelievo USDC (resta nel SCA Circle, non viene trasferita).
# Flat in USDC (0.10 = 10 centesimi) + bps (50 = 0,50%).
# USDC_WITHDRAW_FEE_FLAT="0.10"
# USDC_WITHDRAW_FEE_BPS="50"

# Con Stripe acceso il pagamento demo si spegne da solo.
# Per tenerlo: ZECCA_ALLOW_DEMO_PAY="1"
# Per spegnerlo anche senza Stripe: ZECCA_DISABLE_DEMO_PAY="1"

# I conti @zecca.local si spengono da soli con chiave sk_live_.
# Per spegnerli prima: ZECCA_DISABLE_DEMO_LOGINS="1"

# DHL Express 24h (MyDHL API). Senza queste chiavi il negozio prepara tracking locale.
# DHL_API_KEY="..."
# DHL_API_SECRET="..."
# DHL_ACCOUNT_NUMBER="..."
# DHL_LIVE="1"
# DHL_SHIPPER_PHONE="+390184000000"
# DHL_SHIPPER_EMAIL="massimo@tuo-dominio.it"

# Catena Zecca Gasless (gasPrice 0, chain 22120). ZECCA_GASLESS=0 la spegne (test).
# In-process: Vercel serverless espone POST /api/rails/chain/rpc (niente porta).
# ZECCA_GASLESS="1"
# ZECCA_GASLESS_RPC_URL=""
# ZECCA_TOKEN_ADDRESS="0x..."
# ZECCA_TOKEN_CHAIN_ID="1"
# ZECCA_KMS_BACKEND="zecca-kms"   # zecca-kms | aws-kms | gcp-kms | vault-transit
# AWS_KMS_KEY_ID=""               # CMK ECC_SECG_P256K1 + IAM, altrimenti firma sealed secp256k1
# GCP_KMS_KEY_NAME=""
# ZECCA_VAULT_ADDR=""
# VAULT_TOKEN=""

# Wallet EVM del negozio: facoltativo. Senza questa riga Zecca deriva un wallet
# fisso da AUTH_SECRET (stesso su ogni istanza). Serve al mint (gas) se il contratto è impostato.
# ZECCA_EVM_PRIVATE_KEY="0x..."
# Wallet Bitcoin del negozio: WIF o chiave hex. Senza, si deriva da AUTH_SECRET.
# ZECCA_BTC_WIF=""
# ZECCA_BTC_PRIVATE_KEY=""
# ZECCA_ETH_RPC_URL="https://ethereum.publicnode.com"
# ZECCA_BSC_RPC_URL="https://bsc-dataseed.binance.org"

# Bonifico SEPA in uscita: conto ordinante (da cui parti), distinto dall’IBAN
# beneficiario UniCredit di Massimo. Senza queste righe il pain.001 non si genera
# e Zecca non entra in UniCredit.
# ZECCA_SEPA_DEBTOR_IBAN="IT..."
# ZECCA_SEPA_DEBTOR_NAME="Ragione sociale ordinante"

# Wise API (USD/CHF). Senza token Zecca non prende in carico nessun bonifico
# e non inventa un ID transazione. Il CRO lo incolli in Liquidazione.
# WISE_API_TOKEN=""
# WISE_PROFILE_ID=""
# WISE_API_HOST="https://api.wise.com"
# WISE_SOURCE_CURRENCY="EUR"
# WISE_USD_RECIPIENT_ID=""
# WISE_CHF_RECIPIENT_ID=""

# Liquidity / clearing istituzionale (BTC, ETH, BNB nativi)
# POST {ZECCA_LIQUIDITY_URL}/v1/disburse  → { tx_hash } oppure { id }
# ZECCA_LIQUIDITY_URL="https://clearing.example/api"
# ZECCA_LIQUIDITY_TOKEN=""

# SEPA autenticato: in produzione il binario è /api/rails/sepa (HMAC AUTH_SECRET).
# Gateway esterno BaaS (opzionale). Senza TRN vero il libro resta READY_FOR_SIGNATURE.
# ZECCA_SEPA_BINARY="1"   # forza il binario interno anche fuori Vercel
# ZECCA_SEPA_GATEWAY_URL="https://baas.example/api"
# ZECCA_SEPA_GATEWAY_TOKEN=""
