generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum Pocket {
  VOID
  TREASURY
  USER
  ESCROW
  BURN
}

enum LedgerType {
  MINT
  HOUSE_GRANT
  PURCHASE_CREDITS
  SPEND_ON_ORDER
  CASHOUT_REQUEST
  CASHOUT_PAID
  CASHOUT_REJECTED
  TREASURY_CASHOUT
  TREASURY_CONVERT_TO_EUR
  TREASURY_CONVERT_TO_USD
  TREASURY_CONVERT_TO_CHF
  TREASURY_CONVERT_TO_CRYPTO
  TREASURY_CRYPTO_WITHDRAW
  RATE_CHANGE
}

enum CashoutStatus {
  PENDING
  QUEUED
  PAID
  REJECTED
}

enum OrderStatus {
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  orders          Order[]
  cashouts        CashoutRequest[]
  creditPurchases CreditPurchase[]
  ledgerFrom      LedgerEntry[]    @relation("FromUser")
  ledgerTo        LedgerEntry[]    @relation("ToUser")
  ledgerActor     LedgerEntry[]    @relation("Actor")
}

model Supplier {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  company   String
  street    String
  city      String
  postal    String
  phone     String
  email     String
  products  Product[]
  shipments Shipment[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  imageKey     String
  priceCredits Int
  stock        Int
  active       Boolean  @default(true)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  totalCredits Int
  status       OrderStatus @default(PAID)
  shipTo       String      @default("CUSTOMER")
  shipName     String?
  shipStreet   String?
  shipCity     String?
  shipPostal   String?
  shipNote     String?
  shipPhone    String?
  carrier      String      @default("DHL_EXPRESS")
  service      String      @default("EXPRESS_24H")
  shippingCredits Int      @default(0)
  trackingNumber String?
  trackingUrl  String?
  dhlShipmentId String?
  dhlMessage   String?
  dhlTrackStatus String?
  dhlTrackDetail String?
  dhlTrackedAt DateTime?
  dhlLabelPath String?
  shipStatus   String      @default("TO_PACK")
  shippedAt    DateTime?
  createdAt    DateTime    @default(now())
  items        OrderItem[]
  shipments    Shipment[]
  ledger       LedgerEntry[]

  @@index([trackingNumber])
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  supplierName   String
  supplierStreet String
  supplierCity   String
  supplierPostal String
  supplierPhone  String
  supplierEmail  String
  trackingNumber String?
  trackingUrl    String?
  dhlShipmentId  String?
  dhlMessage     String?
  dhlTrackStatus String?
  dhlTrackDetail String?
  dhlTrackedAt   DateTime?
  dhlLabelPath   String?
  shipStatus     String   @default("AWAITING_SUPPLIER")
  shippedAt      DateTime?
  createdAt      DateTime @default(now())
  items          OrderItem[]

  @@index([trackingNumber])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitCredits Int
}

model LedgerEntry {
  id             String     @id @default(cuid())
  type           LedgerType
  amountCredits  Int
  eurCents       Int        @default(0)
  usdCents       Int        @default(0)
  chfCents       Int        @default(0) // franchi svizzeri; allineato a CashoutRequest.chfCents
  fiatCurrency   String?
  eurDirection   String?
  fromPocket     Pocket
  toPocket       Pocket
  fromUserId     String?
  toUserId       String?
  actorId        String?
  orderId        String?
  cashoutId      String?
  creditPurchaseId String?
  note           String?
  metadata       String?
  createdAt      DateTime   @default(now())

  fromUser       User?           @relation("FromUser", fields: [fromUserId], references: [id])
  toUser         User?           @relation("ToUser", fields: [toUserId], references: [id])
  actor          User?           @relation("Actor", fields: [actorId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id])
  cashout        CashoutRequest? @relation(fields: [cashoutId], references: [id])
  creditPurchase CreditPurchase? @relation(fields: [creditPurchaseId], references: [id])

  @@index([createdAt])
  @@index([type])
  @@index([fromUserId])
  @@index([toUserId])
}

model CashoutRequest {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  credits    Int
  eurCents   Int
  usdCents   Int           @default(0)
  chfCents   Int           @default(0)
  currency   String        @default("EUR")
  status     CashoutStatus @default(PENDING)
  isTreasury Boolean       @default(false)
  payoutKind String        @default("IBAN")
  iban       String?
  ibanHolder String?
  walletAddress String?
  walletNetwork String?
  receiptKind String?
  receiptRef  String?
  receiptUrl  String?
  receiptHash String?
  adminNote  String?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  ledger     LedgerEntry[]
}

model CreditPurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  credits         Int
  eurCents        Int
  method          String
  stripeSessionId String?  @unique
  reference       String?  @unique
  status          String
  createdAt       DateTime @default(now())
  ledger          LedgerEntry[]

  @@index([status])
}

model Setting {
  key   String @id
  value String
}

/** Attestazione firmata del gateway di liquidazione Zecca. Non è un CRO né un tx_hash. */
model GatewayTransmission {
  id             String   @id
  createdAt      DateTime @default(now())
  receivedAt     DateTime
  rail           String
  asset          String
  amountCents    Int
  destination    String
  holder         String?
  cashoutId      String?  @unique
  instructionId  String
  bookRef        String?
  idempotencyKey String   @unique
  status         String   @default("RECEIVED")
  signature      String
  payloadJson    String
  receiptHash    String

  @@index([rail])
  @@index([createdAt])
}

/** Raw signed txs della catena 22120. Replay su ogni cold start (Vercel serverless). */
model GaslessRawTx {
  id          Int      @id @default(autoincrement())
  hash        String   @unique
  raw         String
  txJson      String?
  receiptJson String?
  createdAt   DateTime @default(now())
}
